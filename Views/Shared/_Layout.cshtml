
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - EventVenue</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>
            body {
                margin: 0;
                font-family: Arial, sans-serif;
                background: #F3F7FD;
                color: #172D45;
            }

            .main-navbar {
                min-height: 76px;
                background: #FFFFFF;
                padding: 0 7%;
                display: flex;
                align-items: center;
                justify-content: space-between;
                box-shadow: 0 3px 20px rgba(18, 59, 104, 0.08);
                position: sticky;
                top: 0;
                z-index: 1000;
            }

            .navbar-brand-custom {
                font-size: 25px;
                font-weight: 800;
                color: #123B68;
                text-decoration: none;
            }

                .navbar-brand-custom i {
                    color: #2563EB;
                    margin-right: 7px;
                }

            .navbar-links {
                display: flex;
                align-items: center;
                gap: 28px;
            }

                .navbar-links a {
                    text-decoration: none;
                    color: #475569;
                    font-size: 14px;
                    font-weight: 600;
                }

                    .navbar-links a:hover {
                        color: #2563EB;
                    }

            .navbar-actions {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .nav-login {
                color: #123B68;
                text-decoration: none;
                font-weight: 700;
                padding: 10px 17px;
                border: 1px solid #DBEAFE;
                border-radius: 8px;
            }

            .nav-register {
                color: white;
                background: #2563EB;
                text-decoration: none;
                padding: 11px 19px;
                border-radius: 8px;
                font-weight: 700;
            }

                .nav-register:hover {
                    background: #123B68;
                    color: white;
                }

            .nav-user {
                color: #123B68;
                font-weight: 700;
                font-size: 14px;
            }

            .nav-logout {
                background: #EFF6FF;
                color: #123B68;
                text-decoration: none;
                padding: 10px 15px;
                border-radius: 8px;
                font-weight: 700;
            }

            .main-content {
                min-height: 70vh;
            }

            @@media (max-width: 768px) {
                .main-navbar {
                    padding: 15px 4%;
                    flex-wrap: wrap;
                    gap: 14px;
                }

                .navbar-links {
                    gap: 14px;
                    flex-wrap: wrap;
                }

                .navbar-actions {
                    flex-wrap: wrap;
                }
            }
    </style>
</head>

<body>

    @{
        var isLoggedIn = Context.Session.GetInt32("AppUserId") != null;
        var userName = Context.Session.GetString("AppUserName");
    }

    <nav class="main-navbar">

        <a asp-controller="User" asp-action="Index"
           class="navbar-brand-custom">
            <i class="bi bi-buildings-fill"></i> EventVenue
        </a>

        <div class="navbar-links">
            <a asp-controller="User" asp-action="Index">Home</a>
            <a asp-controller="User" asp-action="Index" asp-fragment="venues">
                Explore Venues
            </a>
            <a asp-controller="User" asp-action="Index" asp-fragment="how-it-works">
                How It Works
            </a>

            @if (isLoggedIn)
            {
                <a asp-controller="User" asp-action="MyBookings">
                    My Bookings
                </a>
            }
        </div>

        <div class="navbar-actions">
            @if (isLoggedIn)
            {
                <span class="nav-user">Hi, @userName</span>

                <a asp-controller="User" asp-action="Logout"
                   class="nav-logout">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </a>
            }
            else
            {
                <a asp-controller="User" asp-action="Login"
                   class="nav-login">Login</a>

                <a asp-controller="User" asp-action="Register"
                   class="nav-register">Get Register</a>
            }
        </div>

    </nav>

    <main class="main-content">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

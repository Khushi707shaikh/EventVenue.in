@model IEnumerable<EventVenue.Models.Booking>

@{
    ViewData["Title"] = "My Bookings";
}

<style>
    .booking-page {
        padding: 55px 7%;
        min-height: 75vh;
        background: #F3F7FD;
    }

    .booking-heading {
        margin-bottom: 30px;
    }

        .booking-heading h2 {
            color: #123B68;
            font-weight: 800;
            font-size: 32px;
        }

        .booking-heading p {
            color: #64748B;
        }

    .booking-card {
        background: white;
        border-radius: 14px;
        padding: 24px;
        margin-bottom: 20px;
        border: 1px solid #E2EAF4;
        box-shadow: 0 5px 20px rgba(18,59,104,0.06);
        display: grid;
        grid-template-columns: 180px 1fr;
        gap: 24px;
    }

    .booking-image {
        width: 180px;
        height: 160px;
        border-radius: 11px;
        object-fit: cover;
        background: #DBEAFE;
    }

    .booking-details h3 {
        color: #123B68;
        font-size: 21px;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .booking-info {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 13px;
        margin: 15px 0;
    }

    .info-item {
        color: #64748B;
        font-size: 13px;
    }

        .info-item strong {
            display: block;
            color: #172D45;
            font-size: 14px;
            margin-top: 4px;
        }

    .booking-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        border-top: 1px solid #E2EAF4;
        padding-top: 15px;
    }

    .booking-price {
        color: #2563EB;
        font-size: 20px;
        font-weight: 800;
    }

    .status {
        display: inline-block;
        padding: 7px 13px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 800;
        background: #DBEAFE;
        color: #1D4ED8;
    }

    .status-confirmed {
        background: #DCFCE7;
        color: #15803D;
    }

    .status-rejected,
    .status-cancelled {
        background: #FEE2E2;
        color: #B91C1C;
    }

    .cancel-btn {
        border: 1px solid #DC2626;
        color: #DC2626;
        background: white;
        padding: 9px 15px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
    }

        .cancel-btn:hover {
            background: #DC2626;
            color: white;
        }

    .empty-bookings {
        background: white;
        border-radius: 15px;
        padding: 65px 20px;
        text-align: center;
        box-shadow: 0 5px 20px rgba(18,59,104,0.05);
    }

        .empty-bookings i {
            font-size: 55px;
            color: #60A5FA;
        }

        .empty-bookings h3 {
            color: #123B68;
            margin: 15px 0 8px;
        }

        .empty-bookings p {
            color: #64748B;
        }

    .explore-btn {
        display: inline-block;
        background: #2563EB;
        color: white;
        text-decoration: none;
        padding: 12px 22px;
        border-radius: 8px;
        font-weight: 700;
        margin-top: 12px;
    }

        .explore-btn:hover {
            background: #123B68;
            color: white;
        }

    @@media (max-width: 650px) {
        .booking-page {
            padding: 35px 5%;
        }

        .booking-card {
            grid-template-columns: 1fr;
        }

        .booking-image {
            width: 100%;
            height: 190px;
        }

        .booking-info {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<div class="booking-page">

    <div class="booking-heading">
        <h2><i class="bi bi-calendar-check"></i> My Bookings</h2>
        <p>View and manage your venue booking requests.</p>
    </div>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }
    @if (Model != null && Model.Any())
    {
        @foreach (var booking in Model)
        {
            <div class="booking-card">

                @if (!string.IsNullOrWhiteSpace(booking.Venue?.ImageUrl))
                {
                    <img class="booking-image"
                         src="@booking.Venue.ImageUrl"
                         alt="@booking.Venue.VenueName" />
                }
                else
                {
                    <img class="booking-image"
                         src="https://images.unsplash.com/photo-1519167758481-83f550bb49b3?auto=format&fit=crop&w=700&q=80"
                         alt="Event venue" />
                }

                <div class="booking-details">

                    <h3>@(booking.Venue?.VenueName ?? "Venue details unavailable")</h3>

                    <div class="booking-info">
                        <div class="info-item">
                            <i class="bi bi-geo-alt"></i> Location
                            <strong>@booking.Venue?.Location</strong>
                        </div>

                        <div class="info-item">
                            <i class="bi bi-calendar-event"></i> Event Date
                            <strong>@booking.EventDate.ToString("dd MMM yyyy")</strong>
                        </div>

                        <div class="info-item">
                            <i class="bi bi-people"></i> Guests
                            <strong>@booking.GuestCount</strong>
                        </div>

                        <div class="info-item">
                            <i class="bi bi-hash"></i> Booking ID
                            <strong>#@booking.BookingId</strong>
                        </div>
                    </div>

                    <div class="booking-footer">
                        <div>
                            <div class="booking-price">
                                ₹@(booking.Venue?.Price.ToString("N0") ?? "N/A")
                            </div>

                            <span class="status
                                @(booking.Status?.Equals("Confirmed", StringComparison.OrdinalIgnoreCase) == true ? "status-confirmed" :
  booking.Status?.Equals("Rejected", StringComparison.OrdinalIgnoreCase) == true ? "status-rejected" :
  booking.Status?.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) == true ? "status-cancelled" : "")">
                                @(booking.Status ?? "Pending")
                            </span>
                        </div>

                        @if (booking.Status?.Equals("Pending", StringComparison.OrdinalIgnoreCase) == true)
                        {
                            <form asp-controller="User"
                                  asp-action="CancelBooking"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to cancel this booking?');">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@booking.BookingId" />

                                <button type="submit" class="cancel-btn">
                                    <i class="bi bi-x-circle"></i> Cancel Booking
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-bookings">
            <i class="bi bi-calendar2-x"></i>
            <h3>No Bookings Yet!</h3>
            <p>You haven't booked any venues. Explore our collection to plan your event.</p>

            <a asp-controller="User"
               asp-action="Index"
               asp-fragment="venues"
               class="explore-btn">
                Explore Venues <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    }

</div>
